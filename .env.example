# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Atlas → Database → Connect → Drivers → copy the string, then replace
# <password> with your database user's password.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cakeshop?retryWrites=true&w=majority

# Sign your own long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# The first admin account, created automatically on first run against an
# empty database. Change these before you deploy.
SEED_ADMIN_NAME=Bakery Owner
SEED_ADMIN_EMAIL=owner@yourbakery.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123
